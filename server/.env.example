DB_HOST=localhost
DB_USER=root
DB_PASSWORD=your_password
DB_NAME=strathbites
DB_PORT=3306
JWT_SECRET=your_jwt_secret_here
PESA_TRACKER_URL=https://your-tunnel.trycloudflare.com/v1

# API keys for external consumers (format: name1:key1,name2:key2)
# Generate a key with:  node generate-api-key.js team10
API_KEYS=team10:<your-api-key>

# API key for accessing Team 8's Pesa Tracker API
PESA_TRACKER_API_KEY=<team8-api-key>

# Rate limit for external consumers (requests per window, per team)
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW_MS=60000

# Pesa Tracker resilience (all optional; these are the defaults)
PESA_TIMEOUT_MS=1500
PESA_WRITE_TIMEOUT_MS=5000
PESA_RETRIES=2
PESA_RETRY_DELAY_MS=200